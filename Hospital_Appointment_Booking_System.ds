		workflow
		{
		form
		{
			auto_generate_patient_code as "Auto-Generate Patient Code"
			{
				type =  form
				form = patient

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Auto-generate unique patient code upon new registration
										if(input.ID.isNull())
										{
											// Fetch the last patient record to get the latest patient code
											lastPatient = patient[ID != 0] sort by ID range from 0 to 1;
											if(lastPatient.count() > 0)
											{
												// Extract the numeric part from the last patient code
												lastCode = lastPatient.patient_code;
												lastCodeNumber = lastCode.replaceAll("PAT-","").toLong();
												newCodeNumber = lastCodeNumber + 1;
											}
											else
											{
												// Start from 1 if no records exist
												newCodeNumber = 1;
											}
											// Format the new patient code with leading zeros (e.g., PAT-0001)
											codeStr = newCodeNumber.toString();
											paddedCode = "";
											if(codeStr.length() < 4)
											{
												paddingLength = 4 - codeStr.length();
												for each  i in List:Float()
												{
													paddedCode = paddedCode.concat("0");
												}
												paddedCode = paddedCode.concat(codeStr);
											}
											else
											{
												paddedCode = codeStr;
											}
											// Set the patient code field
											input.patient_code = "PAT-".concat(paddedCode);
										}
						)
					}
				}

			}
			send_appointment_confirmation as "Send Appointment Confirmation"
			{
				type =  form
				form = appointment

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch patient details using the lookup field
										patientRecord = patient[ID == input.patient];
										// Validate patient email exists
										if(patientRecord.email.isNull())
										{
											success message "Patient email not found. Booking confirmed but no email sent.";
										}
										else
										{
											// Get doctor details for confirmation
											doctorRecord = doctor[ID == input.doctor];
											// Format doctor name
											doctorName = "";
											if(doctorRecord.doctor_name.prefix != null && !doctorRecord.doctor_name.prefix.isEmpty())
											{
												doctorName = doctorName.concat(doctorRecord.doctor_name.prefix).concat(" ");
											}
											if(doctorRecord.doctor_name.first_name != null && !doctorRecord.doctor_name.first_name.isEmpty())
											{
												doctorName = doctorName.concat(doctorRecord.doctor_name.first_name).concat(" ");
											}
											if(doctorRecord.doctor_name.last_name != null && !doctorRecord.doctor_name.last_name.isEmpty())
											{
												doctorName = doctorName.concat(doctorRecord.doctor_name.last_name);
											}
											// Format patient name
											patientName = "";
											if(patientRecord.patient_name.prefix != null && !patientRecord.patient_name.prefix.isEmpty())
											{
												patientName = patientName.concat(patientRecord.patient_name.prefix).concat(" ");
											}
											if(patientRecord.patient_name.first_name != null && !patientRecord.patient_name.first_name.isEmpty())
											{
												patientName = patientName.concat(patientRecord.patient_name.first_name).concat(" ");
											}
											if(patientRecord.patient_name.last_name != null && !patientRecord.patient_name.last_name.isEmpty())
											{
												patientName = patientName.concat(patientRecord.patient_name.last_name);
											}
											// Format appointment date
											appointmentDateStr = input.appointment_date.toString("dd MMMM yyyy");
											// Format appointment time
											appointmentTimeStr = input.appointment_time.toString("hh:mm a");
											// Send confirmation email
											sendmail
											[
												from :zoho.loginuserid
												to :patientRecord.email
												subject :"Appointment Confirmation - " + patientName
												message :"Dear " + patientName + ",\n\nYour appointment has been successfully booked.\n\nAppointment Details:\nDoctor: " + doctorName + "\nDate: " + appointmentDateStr + "\nTime: " + appointmentTimeStr + "\nType: " + input.appointment_type + "\n\nReason for Visit:\n" + input.reason_for_visit + "\n\nWe look forward to seeing you.\n\nBest regards,\nHospital Appointment Booking System"
											]
											success message "Appointment booked successfully. Confirmation email sent to " + patientRecord.email;
										}
						)
					}
				}

			}
		}

		schedule
		{
			daily_doctor_schedule_reminder as "Daily Doctor Schedule Reminder"
			{
				type =  schedule
				form = appointment
					status = inactive
				start = appointment_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch appointments scheduled for today with pending status
										appointments = appointment[appointment_date == zoho.currentdate && appointment_status == "Pending"];
										// Iterate through each appointment and send notification to the doctor
										for each  appointment in appointments
										{
											// Get doctor details from the lookup field
											doctorRecord = doctor[ID == appointment.doctor];
											// Check if doctor email is valid
											if(doctorRecord.email.isNull() == false)
											{
												// Construct the appointment details
												patientName = appointment.patient.patient_name.first_name.concat(" ").concat(appointment.patient.patient_name.last_name);
												appointmentTime = appointment.appointment_time.toString();
												appointmentDate = appointment.appointment_date.toString();
												reason = appointment.reason_for_visit;
												// Send email notification to the doctor
												sendmail
												[
													from :zoho.loginuserid
													to :doctorRecord.email
													subject :"Upcoming Appointment Reminder - " + appointmentDate
													message :"Dear " + doctorRecord.doctor_name.first_name + ",\n\nYou have an upcoming appointment scheduled for " + appointmentDate + " at " + appointmentTime + ".\n\nPatient Details:\nName: " + patientName + "\nReason for Visit: " + reason + "\n\nPlease ensure you are available for this appointment.\n\nThank you,\nHospital Appointment Booking System"
												]
											}
										}
					)
					}
				}
			}
		}


