 application "Hospital Appointment Booking System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form appointment
		{
			displayname = "Appointment"
			success message = "Appointment Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			appointment_date
			(
    			type = date
				displayname = "Appointment Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			appointment_time
			(
    			type = time
				displayname = "Appointment Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			appointment_type
			(
				type = picklist
				displayname = "Appointment Type"
				values = {"Consultation","Emergency","Follow-up"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			reason_for_visit
			(
    			type = textarea
				displayname = "Reason For Visit"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			appointment_status
			(
				type = picklist
				displayname = "Appointment Status"
				values = {"Completed","Confirmed","Cancelled","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			payment_status
			(
				type = radiobuttons
				displayname = "Payment Status"
				values = {"Paid","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			booking_date
			(
    			type = datetime
				displayname = "Booking Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			patient
			(
				type = picklist	
				displayname = "Patient"
				values  = patient.ID
    			displayformat = [patient_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			doctor
			(
				type = picklist	
				displayname = "Doctor"
				values  = doctor.ID
    			displayformat = [doctor_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			department
			(
				type = picklist	
				displayname = "Department"
				values  = department.ID
    			displayformat = [department_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Appointment Draft","Appointment Pending Review","Appointment Cancelled","Appointment Confirmed","Appointment Rescheduled","Appointment In Progress","Appointment Completed","Appointment On Hold","Appointment Payment Pending","Appointment Closed","Appointment Payment Confirmed","Appointment Payment Failed"}
			}
		}
		form department
		{
			displayname = "Department"
			success message = "Department Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			department_name
			(
    			type = text
				displayname = "Department Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			department_status
			(
				type = radiobuttons
				displayname = "Department Status"
				values = {"Active","Inactive"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			department_code
			(
    			type = text
				displayname = "Department Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form doctor
		{
			displayname = "Doctor"
			success message = "Doctor Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			doctor_name
			(
    			type = name
				displayname = "Doctor Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			specialization
			(
    			type = text
				displayname = "Specialization"
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			available_days
			(
				type = list	
				displayname = "Available Days"
				values = {"Monday","Thursday","Friday","Sunday","Wednesday","Tuesday","Saturday"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			available_from
			(
    			type = time
				displayname = "Available From"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			available_to
			(
    			type = time
				displayname = "Available To"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			consultation_fee
			(
				displayname = "Consultation Fee"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			doctor_status
			(
				type = radiobuttons
				displayname = "Doctor Status"
				values = {"Active","Inactive"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			doctor_code
			(
    			type = text
				displayname = "Doctor Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form patient
		{
			displayname = "Patient"
			success message = "Patient Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			patient_name
			(
    			type = name
				displayname = "Patient Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			date_of_birth
			(
    			type = date
				displayname = "Date Of Birth"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			gender
			(
				type = picklist
				displayname = "Gender"
				values = {"Male","Female","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			address
			(
    			type = address
				displayname = "Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			blood_group
			(
				type = picklist
				displayname = "Blood Group"
				values = {"A","AB","B","B+","A+","AB+","B-","A-","O+","AB-","O-","O"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			emergency_contact
			(
    			type = phonenumber
				displayname = "Emergency Contact"
	 			row = 1
	 			column = 1   
				width = medium
			)
			registration_date
			(
    			type = date
				displayname = "Registration Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			patient_code
			(
    			type = text
				displayname = "Patient Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form user_account
		{
			displayname = "User Account"
			success message = "User Account Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			user_name
			(
    			type = name
				displayname = "User Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			role
			(
				type = picklist
				displayname = "Role"
				values = {"Receptionist","Patient","Doctor","Admin"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			account_status
			(
				type = radiobuttons
				displayname = "Account Status"
				values = {"Active","Inactive"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			user_code
			(
    			type = text
				displayname = "User Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list appointment_Report
		{
			displayName = "All Appointments"
			show all rows from appointment    
			(
				appointment_date as "Appointment Date"
				appointment_time as "Appointment Time"
				appointment_type as "Appointment Type"
				reason_for_visit as "Reason For Visit"
				appointment_status as "Appointment Status"
				payment_status as "Payment Status"
				booking_date as "Booking Date"
				patient as "Patient"
				doctor as "Doctor"
				department as "Department"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (appointment_status == "Cancelled")
				fields = [appointment_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (appointment_status == "Confirmed")
				fields = [appointment_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (appointment_status == "Pending")
				fields = [appointment_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban appointment_by_appointment_status
		{
			displayName = "Appointment Statuses"
			show all rows from appointment    
			(
				appointment_date as "Appointment Date"
				appointment_time as "Appointment Time"
				appointment_type as "Appointment Type"
				reason_for_visit as "Reason For Visit"
				appointment_status as "Appointment Status"
				payment_status as "Payment Status"
				booking_date as "Booking Date"
				patient as "Patient"
				doctor as "Doctor"
				department as "Department"
			)
			options
			(
	 			display field = appointment_status
	 		)
		}
		list patient_Report
		{
			displayName = "All Patients"
			show all rows from patient    
			(
				patient_name  as "Patient Name"
				date_of_birth as "Date Of Birth"
				gender as "Gender"
				phone_number as "Phone Number"
				email as "Email"
				address  as "Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				blood_group as "Blood Group"
				emergency_contact as "Emergency Contact"
				registration_date as "Registration Date"
				patient_code as "Patient Code"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (gender == "Female")
				fields = [gender]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (gender == "Male")
				fields = [gender]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (gender == "Other")
				fields = [gender]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban patient_by_gender
		{
			displayName = "Genders"
			show all rows from patient    
			(
				patient_name  as "Patient Name"
				date_of_birth as "Date Of Birth"
				gender as "Gender"
				phone_number as "Phone Number"
				email as "Email"
				address  as "Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				blood_group as "Blood Group"
				emergency_contact as "Emergency Contact"
				registration_date as "Registration Date"
				patient_code as "Patient Code"
			)
			options
			(
	 			display field = gender
	 		)
		}
		list department_Report
		{
			displayName = "All Departments"
			show all rows from department    
			(
				department_name as "Department Name"
				description as "Description"
				department_status as "Department Status"
				department_code as "Department Code"
			)
		}
		list doctor_Report
		{
			displayName = "All Doctors"
			show all rows from doctor    
			(
				doctor_name  as "Doctor Name"
				specialization as "Specialization"
				phone_number as "Phone Number"
				email as "Email"
				available_days as "Available Days"
				available_from as "Available From"
				available_to as "Available To"
				consultation_fee as "Consultation Fee"
				(
					display = total,average,min,max	
				)
				doctor_status as "Doctor Status"
				doctor_code as "Doctor Code"
			)
		}
		list user_account_Report
		{
			displayName = "All User Accounts"
			show all rows from user_account    
			(
				user_name  as "User Name"
				email as "Email"
				phone_number as "Phone Number"
				role as "Role"
				account_status as "Account Status"
				user_code as "User Code"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (role == "Patient")
				fields = [role]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (role == "Receptionist")
				fields = [role]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban user_account_by_role
		{
			displayName = "Roles"
			show all rows from user_account    
			(
				user_name  as "User Name"
				email as "Email"
				phone_number as "Phone Number"
				role as "Role"
				account_status as "Account Status"
				user_code as "User Code"
			)
			options
			(
	 			display field = role
	 		)
		}
	}
	pages
	{
		page DashBoard
